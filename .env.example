# Claude API
ANTHROPIC_API_KEY=

# PubMed (E-utilities) — optionnel mais recommandé pour un quota plus élevé
# https://www.ncbi.nlm.nih.gov/account/settings/ (onglet API Key Management)
PUBMED_API_KEY=
PUBMED_TOOL_NAME=shinrin-yoku-agent
PUBMED_CONTACT_EMAIL=

# Paramètres de recherche, appliqués à chacune des 6 thématiques définies dans
# src/themes.js (requêtes et chercheurs de référence par thématique, non configurables
# via l'environnement — modifier src/themes.js pour ajouter/ajuster une thématique).
# Important : les requêtes utilisent les tags [Title/Abstract] pour éviter l'expansion
# automatique de PubMed (Automatic Term Mapping), qui sinon élargit par ex. "shinrin-yoku"
# vers "forest"[All Fields] AND "therapy"[All Fields] et ramène des milliers de résultats
# hors sujet.
PUBMED_MAX_RESULTS=20

# Requêtes prioritaires par auteur de référence (une par thématique, cf. src/themes.js) —
# combinées aux mots-clés de chaque thématique, indépendamment configurable en nombre de
# résultats
PUBMED_REFERENCE_AUTHOR_MAX_RESULTS=10

# SMTP (envoi du rapport par email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Veille La Borbolla <veille@brana-sana.example>"

# Destinataires (2 adresses configurables)
RECIPIENT_EMAIL_1=
RECIPIENT_EMAIL_2=

# URL du tableau de bord publié (GitHub Pages) — optionnel, ajouté en tête du rapport
# quand renseigné. Vide en local (pas de page publiée depuis un poste local).
DASHBOARD_URL=
