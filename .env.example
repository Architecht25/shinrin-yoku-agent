# Claude API
ANTHROPIC_API_KEY=

# PubMed (E-utilities) — optionnel mais recommandé pour un quota plus élevé
# https://www.ncbi.nlm.nih.gov/account/settings/ (onglet API Key Management)
PUBMED_API_KEY=
PUBMED_TOOL_NAME=shinrin-yoku-agent
PUBMED_CONTACT_EMAIL=

# Paramètres de recherche
# Important : les tags [Title/Abstract] évitent l'expansion automatique de PubMed
# (Automatic Term Mapping), qui sinon élargit "shinrin-yoku" vers "forest"[All Fields]
# AND "therapy"[All Fields] et ramène des milliers de résultats hors sujet.
PUBMED_QUERY="shinrin-yoku"[Title/Abstract] OR "forest bathing"[Title/Abstract] OR "forest therapy"[Title/Abstract] OR "nature therapy"[Title/Abstract]
PUBMED_MAX_RESULTS=20

# SMTP (envoi du rapport par email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Veille Shinrin-yoku <veille@brana-sana.example>"

# Destinataires (2 adresses configurables)
RECIPIENT_EMAIL_1=
RECIPIENT_EMAIL_2=
